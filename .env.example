# Configurações de Provedores de LLM para o Agente da Empório da Música
# O agente funciona de forma 100% autônoma mesmo sem chaves (usando o motor local embutido).
# Caso deseje integrar com LLMs em nuvem, preencha as variáveis abaixo:

# Provedor padrão (opções: groq, openai, ollama, local_engine)
LLM_PROVIDER=local_engine

# Groq API (Recomendado para alta performance gratuita com Llama 3.3 70B)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API (Opcional, ex: gpt-4o-mini)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama (Para execução 100% local via Ollama, padrão porta 11434)
OLLAMA_BASE_URL=http://localhost:11434/v1
